{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smilegroupsato/sc-crypto-ops/gateway-adapter/intent-schema-v0.1.json",
  "title": "SC Crypto Ops Gateway Adapter Intent Schema v0.1",
  "description": "ChatGPT/Paper Plan/Web UIからGateway Adapterへ渡すIntent schema。portfolio_idとidempotency_keyを必須にする。Portfolioの安全設定はgateway-adapter/config/portfolios.v0.1.jsonを上位正本とし、Intentから緩めてはならない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "idempotency_key",
    "portfolio_id",
    "created_at_jst",
    "created_by",
    "intent_type",
    "execution_mode",
    "venue_type",
    "venue",
    "asset_flow",
    "risk",
    "safety",
    "ledger",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^INT-[0-9]{8}-[0-9]{3,6}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:-]{8,120}$",
      "description": "同じ注文を二重実行しないための安定キー。portfolio_id + logical order idなどから作る。"
    },
    "portfolio_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_:-]{2,80}$",
      "description": "実行対象portfolio。安全設定はportfolio configを上位正本とする。"
    },
    "approval_policy": {
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ],
      "description": "任意。指定されてもportfolio configより緩くできない。"
    },
    "created_at_jst": {
      "type": "string",
      "description": "YYYY-MM-DD HH:MM JST"
    },
    "created_by": {
      "type": "string",
      "enum": [
        "sato",
        "chatgpt",
        "paper_plan",
        "web_ui",
        "manual_import",
        "system"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chat_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "related_plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "related_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "intent_type": {
      "type": "string",
      "enum": [
        "trade",
        "transfer",
        "approve",
        "swap",
        "bridge",
        "claim",
        "dapp_call",
        "cancel",
        "record_manual_execution"
      ]
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "paper",
        "shadow",
        "live_confirmed",
        "live_auto"
      ]
    },
    "venue_type": {
      "type": "string",
      "enum": [
        "cex",
        "wallet",
        "defi",
        "dapp",
        "manual"
      ]
    },
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "chain": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ethereum",
        "base",
        "arbitrum",
        "optimism",
        "polygon",
        "solana",
        "bitcoin",
        "none",
        null
      ]
    },
    "network_id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "asset_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "from_asset",
        "to_asset",
        "amount_type"
      ],
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "BUY",
            "SELL",
            "SWAP",
            "TRANSFER",
            "APPROVE",
            "CLAIM",
            "NONE"
          ]
        },
        "from_asset": {
          "type": [
            "string",
            "null"
          ]
        },
        "to_asset": {
          "type": [
            "string",
            "null"
          ]
        },
        "coingecko_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "from_contract_address": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0x[a-fA-F0-9]{40})?$"
        },
        "to_contract_address": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0x[a-fA-F0-9]{40})?$"
        },
        "amount_type": {
          "type": "string",
          "enum": [
            "jpy_budget",
            "asset_quantity",
            "full_balance",
            "quote_only",
            "none"
          ]
        },
        "amount_jpy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "from_amount": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "to_amount_min": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "price_limit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Paper v0.1ではJPYの仮定約定価格としても使う。"
        },
        "price_limit_currency": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "JPY",
            "USD",
            "USDT",
            "USDC",
            "BTC",
            "ETH",
            "none",
            null
          ]
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_loss_jpy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "slippage_bps_max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "gas_jpy_max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "fee_jpy_max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "daily_limit_jpy_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "cash_reserve_ratio_min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "requires_manual_confirm": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "stop_loss_condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "take_profit_condition": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safety_profile",
        "toggles"
      ],
      "properties": {
        "safety_profile": {
          "type": "string",
          "enum": [
            "strict",
            "normal",
            "custom",
            "danger"
          ]
        },
        "toggles": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ledger_target": {
          "type": "string",
          "enum": [
            "paper_ledger",
            "sc_crypto_accounting_ledger",
            "none"
          ]
        },
        "evidence_required": {
          "type": "boolean"
        },
        "jpy_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "check_status_default": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
